# ============================================================
# WALLET (REQUIS pour le mode LIVE uniquement)
# ============================================================
# Cle privee du signataire, exportee depuis ton wallet (Phantom:
# nom du compte -> crayon -> Show Private Key -> reseau Polygon).
# Format: 0x + 64 caracteres hex (66 au total).
# L'adresse derivee doit correspondre a "Adresse du signataire" sur
# Polymarket. Le bot derive lui-meme ses identifiants CLOB (api key,
# secret, passphrase): rien d'autre a mettre ici.
# La simulation (DRY_RUN=true) n'a besoin d'aucune cle.
POLYMARKET_PRIVATE_KEY=your_private_key_here

# ============================================================
# MODE ET CAPITAL
# ============================================================
# true  = simulation (paper broker sur carnets reels, aucun ordre envoye)
# false = trading reel avec de vrais fonds
DRY_RUN=true

# Budget de risque, PAS le solde du wallet. Determine la taille des
# positions et les limites de risque.
CAPITAL_USD=50
# Share of the book that may sit in open positions at once (0.30 = 30%).
MAX_TOTAL_EXPOSURE_PCT=0.30

# ============================================================
# STRATEGIES
# ============================================================
# Attention aux defauts du code s'ils sont absents:
#   SMARTMONEY_ENABLED est ACTIVE par defaut (teste != 'false')
#   les trois autres sont DESACTIVEES par defaut (testent === 'true')
# Ils sont donc tous explicites ici. Active seulement ce que tu testes.
SMARTMONEY_ENABLED=false
ARBITRAGE_ENABLED=false
DIPARB_ENABLED=false
TREND_ANALYSIS_ENABLED=false

# ============================================================
# GESTION DU RISQUE (en % du capital)
# ============================================================
DAILY_MAX_LOSS_PCT=5
MONTHLY_MAX_LOSS_PCT=15
MAX_DRAWDOWN_PCT=20
TOTAL_MAX_LOSS_PCT=25

# ============================================================
# SIMULATION (paper broker)
# ============================================================
# Repartir d'un compte papier vierge au lieu de recharger
# data/paper-state.json
# PAPER_RESET=true

# Frais taker modelises en simulation (0 = defaut Polymarket)
# PAPER_FEE_RATE=0

# ============================================================
# DASHBOARD
# ============================================================
# Le dashboard peut basculer en LIVE, vendre des positions et redeem.
# Garde-le en local.
# DASHBOARD_PORT=3001

# Ecoute sur la loopback par defaut. Ne change ca que derriere un
# proxy authentifie.
# DASHBOARD_HOST=127.0.0.1

# Secret partage optionnel: http://localhost:3001/?token=change-me
# Obligatoire des que DASHBOARD_HOST n'est plus 127.0.0.1.
# DASHBOARD_TOKEN=change-me

# true = le bouton "Switch to LIVE" du dashboard fonctionne.
# Laisse false et relance avec DRY_RUN=false pour passer en reel.
ALLOW_DASHBOARD_LIVE_TOGGLE=false

# ============================================================
# RESEAU (optionnel)
# ============================================================
# RPC Polygon. Defaut: https://polygon-rpc.com
# Un endpoint dedie (Alchemy, Infura) est plus fiable sous charge.
# polygon-rpc.com now answers 403 ("tenant disabled"); this is the default.
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
